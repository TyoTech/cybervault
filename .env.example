APP_NAME="Cyber Vault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Root direktori vault lokal (folder fisik notes/challenges/payloads).
# Contoh: CYBER_DISK_ROOT=/home/tyo/cyber
# Jika kosong, fallback ke storage/app/cyber (aman untuk development).
CYBER_DISK_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== Real Email — Gmail SMTP (reset password) =====
# Default dev: MAIL_MAILER=log (email hanya ditulis ke storage/logs).
# Untuk pengiriman nyata melalui Gmail SMTP, isi kredensial di bawah:
#   MAIL_USERNAME  -> alamat Gmail pengirim
#   MAIL_PASSWORD  -> Google App Password (16 karakter), BUKAN password Gmail biasa.
#                     Wajib 2-Step Verification aktif: https://myaccount.google.com/apppasswords
# JANGAN pernah menaruh App Password nyata pada file ini — ini hanya template.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Cyber Vault"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Local AI (Ollama) — fitur Improve Writeup (Phase 4) =====
# Base URL server Ollama lokal. Hanya dari environment, bukan input user.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=60
